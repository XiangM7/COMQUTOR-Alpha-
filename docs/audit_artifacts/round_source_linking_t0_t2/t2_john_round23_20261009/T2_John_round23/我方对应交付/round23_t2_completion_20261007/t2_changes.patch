+    "INVALID_RUN_ID": 400,
+    "INVALID_CLAIM_ID": 400,
+    "REVIEWER_REQUIRED": 400,
+    "RATIONALE_REQUIRED": 400,
+    "INVALID_CONTENT_SUPPORT_STATUS": 400,
+    "AGENT_OUTPUTS_NOT_READY": 404,
+    "AGENT_OUTPUTS_CORRUPTED": 409,
+    "CLAIM_NOT_FOUND": 404,
