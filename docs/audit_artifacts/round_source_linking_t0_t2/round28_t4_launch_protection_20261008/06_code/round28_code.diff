+def write_week2_gateway_budget(run_dir: Path, *, max_calls: int, reservations: int) -> Path:
+    """Atomic write of the gateway's cap and the reservations it counted against it. The cap
+    (COMQUTOR_WEEK2_LLM_MAX_CALLS) limits RESERVATIONS -- one is taken immediately before every attempt -- not HTTP
+    requests: a reserved attempt refused at the transport (provider stop, audit failure) never becomes a request."""
+    run_dir = Path(run_dir)
+    record = {"schema_version": GATEWAY_BUDGET_SCHEMA_VERSION, "max_calls": int(max_calls), "budget_reservations": int(reservations),
+              "written_at": datetime.now(UTC).isoformat()}
+    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=run_dir, prefix=".week2_gateway_budget.", suffix=".tmp", delete=False) as handle:
+        handle.write(json.dumps(record, indent=1) + "\n")
+        tmp_path = handle.name
+    os.replace(tmp_path, run_dir / GATEWAY_BUDGET_FILENAME)
+    return run_dir / GATEWAY_BUDGET_FILENAME
+
