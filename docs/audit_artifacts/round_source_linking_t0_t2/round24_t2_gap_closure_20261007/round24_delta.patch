+        logger.warning("formal acceptance: run_audit.json unreadable (run_id=%s)", run_id, exc_info=True)
+        return None
+    summary = audit.get("activation_summary") if isinstance(audit, dict) else None
+    return summary if isinstance(summary, dict) else None
 
 
