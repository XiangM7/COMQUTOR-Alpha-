+        "blocking": bool(rule.get("blocking")),
+        "evidence_condition": rule.get("evidence_condition"),
+        "required_behavior": rule.get("required_behavior"),
+        "authority_basis": list(RULE_AUTHORITY_BASIS.get(str(rule["rule_id"]), ())),
