+            },
+            output_root=output_root,
+        )
+
+    return {
+        "status": "ok",
+        "run_id": safe_run_id,
+        "execution_id": execution_id,
+        "based_on_run_id": safe_run_id,
+        "review_log_entry_count": len(reviews),
