+  transition: background-color 0.2s, transform 0.15s var(--ease-spring);
+}
+
+.cta-button:hover:not(:disabled) {
+  background: var(--color-primary-hover);
+}
+
+.cta-button:active:not(:disabled) {
+  transform: scale(0.97);
+}
+
