+}
+
+.recent-runs-menu-title {
+  font-size: 13px;
+  font-weight: 600;
+}
+
+.recent-runs-filter {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2);
+  flex-wrap: wrap;
+}
+
+.recent-runs-filter input {
+  width: 160px;
+  min-width: 0;
+  height: 32px;
+  padding: 0 12px;
+  border: 1px solid var(--color-border);
+  border-radius: 980px;
+  background: var(--color-surface);
+  color: var(--color-text);
+  font: inherit;
+  font-size: 13px;
+}
+
+.menu-text-button {
+  padding: 4px 6px;
+  border: 0;
+  background: transparent;
+  color: var(--color-link);
+  font: inherit;
+  font-size: 13px;
+  cursor: pointer;
+}
+
+.menu-text-button:hover {
+  text-decoration: underline;
+}
+
+.recent-runs-scroll {
+  max-height: 336px;
+  overflow-y: auto;
+  padding: 0 8px 8px;
+}
+
+.recent-runs-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.recent-run-row {
+  display: grid;
+  grid-template-columns: 76px minmax(0, 1fr) auto 12px;
