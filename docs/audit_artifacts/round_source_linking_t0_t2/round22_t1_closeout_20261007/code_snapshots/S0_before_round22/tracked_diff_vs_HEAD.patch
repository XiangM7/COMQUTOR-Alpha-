     newly_applied: list[str] = []
     for version, tables in MIGRATIONS:
@@ -39,4 +86,5 @@ def apply_migrations(engine: Engine) -> list[str]:
                 sa.insert(schema_migrations).values(version=version, applied_at=datetime.now(UTC))
             )
