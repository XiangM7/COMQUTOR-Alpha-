+}
+
+.chevron-open {
+  transform: rotate(180deg);
+}
+
+.cta-button {
+  min-width: 150px;
+  height: 44px;
+  padding: 0 22px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  border: 0;
+  border-radius: 980px;
+  background: var(--color-primary);
+  color: var(--color-primary-contrast);
+  font: inherit;
+  font-size: 15px;
+  font-weight: 500;
