+    if (contentType.includes("application/json")) {
+      try {
+        const body = await response.json();
+        if (looksLikeErrorEnvelope(body)) {
+          throw ApiError.http(
+            response.status,
+            body.error_code ?? null,
+            body.message ?? `Export failed with status ${response.status}.`
+          );
