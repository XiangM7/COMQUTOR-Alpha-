+}
+
+.recent-runs-state p {
+  margin: 0;
+}
+
+.recent-runs-state .recent-runs-state-title {
+  margin-bottom: 4px;
+  font-weight: 600;
+  color: var(--color-text);
+}
+
+.recent-runs-state-error {
+  color: var(--color-danger);
+}
+
+.recent-runs-load-more {
