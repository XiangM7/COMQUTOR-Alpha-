+
+.trace-heading h2 {
+  margin: 0;
+  max-width: 18ch;
+  font-size: 32px;
+  line-height: 1.15;
+  font-weight: 600;
+  letter-spacing: -0.025em;
+}
+
+.trace-heading p {
+  margin: 0;
+  max-width: 44ch;
+  font-size: 15px;
+  line-height: 1.5;
+  color: var(--color-text-muted);
+}
+
+.trace-chain {
+  display: flex;
+  align-items: stretch;
+  flex-wrap: wrap;
+  row-gap: 16px;
+}
+
+.trace-step {
+  flex: 1 1 220px;
+  min-width: 0;
+  display: flex;
+  align-items: stretch;
+}
+
+.trace-step:not(:first-child) {
+  flex-basis: 252px;
+}
+
+.trace-link {
+  flex: 0 0 32px;
+  align-self: center;
+  height: 1px;
+  background: var(--color-text-faint);
+  transform: scaleX(0);
+  transform-origin: left;
+  animation: trace-draw 0.5s var(--ease-spring) forwards;
+}
+
+.trace-node {
+  flex: 1 1 0;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  padding: 22px;
