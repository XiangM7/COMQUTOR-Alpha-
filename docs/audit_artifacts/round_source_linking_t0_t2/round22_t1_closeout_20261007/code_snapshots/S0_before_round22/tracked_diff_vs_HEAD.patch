+  border: 1px solid var(--color-border-subtle);
+  border-radius: 18px;
+  opacity: 0;
+  transform: translateY(6px);
+  animation: trace-in 0.7s var(--ease-spring) forwards;
+}
+
+.trace-node-kind {
+  font-size: 12px;
+  color: var(--color-text-muted);
+}
+
+.trace-node-text {
+  margin: 0;
+  font-size: 15px;
+  line-height: 1.45;
+  font-weight: 500;
+}
+
+.trace-node-note {
+  margin-top: auto;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 12px;
+  color: var(--color-text-muted);
+}
+
+.trace-node-note-active {
+  color: var(--status-active-text);
+  font-weight: 500;
+}
+
+.trace-node-emphasis {
+  background: var(--color-invert-bg);
+  color: var(--color-invert-text);
+  border-color: transparent;
+}
+
+.trace-node-emphasis .trace-node-kind {
+  color: var(--color-invert-muted);
+}
+
+.trace-node-emphasis .trace-node-note {
+  color: var(--color-invert-text);
+}
+
+@keyframes trace-in {
+  to { opacity: 1; transform: none; }
+}
+
+@keyframes trace-draw {
+  to { transform: scaleX(1); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .trace-node,
+  .recent-runs-menu {
+    animation: none;
+    opacity: 1;
+    transform: none;
+  }
+
+  .trace-link {
+    animation: none;
+    transform: none;
+  }
+
+  .chevron,
+  .cta-button,
+  .research-hero h1,
+  .research-hero-subtitle,
+  .research-hero .ghost-button {
+    transition: none;
+  }
+}
+
+@media (max-width: 720px) {
+  .research-hero {
+    padding: 72px 0 96px;
+  }
+
+  .trace-link {
+    display: none;
+  }
+
+  .recent-run-row {
+    grid-template-columns: 64px minmax(0, 1fr) 12px;
+  }
+
+  .recent-run-created {
+    display: none;
+  }
 }
