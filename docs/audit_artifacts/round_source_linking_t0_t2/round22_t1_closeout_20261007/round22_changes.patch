diff -ruN S0/tests/replay/test_capture_artifacts_replay_compat.py S1/tests/replay/test_capture_artifacts_replay_compat.py
--- S0/tests/replay/test_capture_artifacts_replay_compat.py	1969-12-31 16:00:00
+++ S1/tests/replay/test_capture_artifacts_replay_compat.py	2026-10-07 17:42:12
@@ -0,0 +1,69 @@
+"""T1 closeout (Round 22): a run that carries the two additive capture artifacts still replays exactly, and a run without them
+(every historical run) is read exactly as before.
+
+``derived_inputs.json`` / ``provider_response_audit.json`` are present-only extras of a LIVE run's directory: the exact
+semantic replay snapshots the source directory, checks the artifact manifest's hashes and replays from the saved semantic
+artifacts only. This proves the extras neither break that nor get copied into (or read by) the replay -- using the same
+offline fixture run the other replay tests use. Synthetic payloads; zero Provider calls.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from comqutor_alpha.api.artifact_export import build_and_write_artifact_manifest
+from comqutor_alpha.capture_artifacts import (
+    DERIVED_INPUTS_FILENAME,
+    PROVIDER_RESPONSE_AUDIT_FILENAME,
+    build_derived_inputs_artifact,
+    build_provider_response_artifact,
+)
+from comqutor_alpha.replay.exact_semantic import run_exact_semantic_replay
+from comqutor_alpha.replay.source_bundle import load_exact_semantic_source_bundle, verify_source_bundle_unchanged
+from comqutor_alpha.storage.file_store import save_json_record
+from tests.replay.conftest import file_tree_snapshot
+
+
+def _add_capture_artifacts(source: Path) -> None:
+    run_id = source.name
+    ticker = json.loads((source / "metadata.json").read_text(encoding="utf-8"))["ticker"]
+    series = {
+        "time_index": {"name": "Date", "format": "YYYY-MM-DD", "timezone_assumed": "America/New_York", "order": "ascending"},
+        "columns": ["Open", "High", "Low", "Close", "Volume"],
+        "rows": [["2026-06-29", 1.0, 2.0, 0.5, 1.5, 10], ["2026-06-30", 1.5, 2.5, 1.0, 2.0, 12]],
+    }
+    from comqutor_alpha.capture_artifacts import series_sha256
+
+    series.update({"row_count": 2, "first_date": "2026-06-29", "last_date": "2026-06-30", "sha256": series_sha256(series)})
+    inputs = build_derived_inputs_artifact(
+        run_id=run_id, ticker=ticker,
+        entries=[{"input_id": "src_synthetic#ohlcv_window", "source_id": "src_synthetic", "kind": "ohlcv_window", "series": series,
+                  "method": {"indicators": []}, "outputs": {"indicators": {}}}],
+    )
+    audit = build_provider_response_artifact(run_id=run_id, ticker=ticker, entries=[])
+    save_json_record(run_id, DERIVED_INPUTS_FILENAME, inputs, output_root=source.parent)
+    save_json_record(run_id, PROVIDER_RESPONSE_AUDIT_FILENAME, audit, output_root=source.parent)
+    build_and_write_artifact_manifest(run_id=run_id, ticker=ticker, output_root=source.parent)  # lists them, with their real hashes
+
+
+def test_a_live_run_with_the_new_artifacts_loads_and_replays_exactly_and_the_extras_are_not_copied(tmp_path: Path, eligible_live_source: Path) -> None:
+    before_plain = load_exact_semantic_source_bundle(eligible_live_source)
+    plain_files = {f.relative_path for f in before_plain.source_files}
+    assert DERIVED_INPUTS_FILENAME not in plain_files  # a run without them is read exactly as before
+
+    _add_capture_artifacts(eligible_live_source)
+    bundle = load_exact_semantic_source_bundle(eligible_live_source)
+    assert {f.relative_path for f in bundle.source_files} >= {DERIVED_INPUTS_FILENAME, PROVIDER_RESPONSE_AUDIT_FILENAME}
+    assert verify_source_bundle_unchanged(bundle) is True
+
+    snapshot = file_tree_snapshot(eligible_live_source)
+    output_root = tmp_path / "exact-replays"
+    result = run_exact_semantic_replay(eligible_live_source, output_root, replay_id="exact-replay-with-capture-artifacts")
+    replay_dir = output_root / "exact-replay-with-capture-artifacts"
+
+    assert result.status == "completed" and result.provider_calls == 0 and result.market_data_calls == 0
+    assert file_tree_snapshot(eligible_live_source) == snapshot  # the source run is still read-only
+    assert not (replay_dir / DERIVED_INPUTS_FILENAME).exists() and not (replay_dir / PROVIDER_RESPONSE_AUDIT_FILENAME).exists()
+    binding = json.loads((replay_dir / "semantic_binding_audit.json").read_text(encoding="utf-8"))
+    assert binding["final_status"] == "PASS"
diff -ruN S0/tests/test_t1_closeout_capture_artifacts.py S1/tests/test_t1_closeout_capture_artifacts.py
--- S0/tests/test_t1_closeout_capture_artifacts.py	1969-12-31 16:00:00
+++ S1/tests/test_t1_closeout_capture_artifacts.py	2026-10-07 17:42:12
@@ -0,0 +1,491 @@
+"""T1 closeout (Round 22): the two additive capture artifacts -- ``derived_inputs.json`` and ``provider_response_audit.json``.
+
+Everything here is OFFLINE and uses EXPLICITLY SYNTHETIC inputs (hand-built OHLCV frames, hand-built provider article dicts
+returned by a fake ``yfinance``): it proves the saving / recomputation / redaction MECHANISM. It is not a real-market
+validation sample and says nothing about what a real run's provider returns. Zero network, zero Provider calls.
+
+Claims proven:
+  derived inputs
+    * the COMPLETE input window is saved (every row, time index, columns, units, ascending order) -- not a row count;
+    * the saved inputs ALONE reproduce every saved indicator (no cache, no refetch, no original frame);
+    * tampering is detected (hash) and a tampered-but-rehashed series no longer reproduces the saved outputs;
+    * the recorded processing settings are the ones the code actually used (``load_ohlcv`` / ``_clean_dataframe``);
+    * the recorded indicator definitions are true for the pinned library;
+    * the registry only gains two pointer keys; legacy sources/runs without the artifact still load.
+  provider responses
+    * the raw response is saved, sanitized (secret patterns and sensitive URL parameters redacted), next to what the parser
+      read; the tool's returned text is byte-identical with and without capture;
+    * with-summary / empty-summary-with-description / title-only / flat shapes are each handled and classified factually;
+    * the parser-field record equals the parser's real behaviour.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import pytest
+
+import tradingagents.dataflows.market_data_validator as validator
+import tradingagents.dataflows.stockstats_utils as stockstats_utils
+import tradingagents.dataflows.yfinance_news as ynews
+from comqutor_alpha.adapters.tradingagents_output_writer import save_comqutor_run_outputs
+from comqutor_alpha.api.artifact_export import build_and_write_artifact_manifest
+from comqutor_alpha.capture_artifacts import (
+    CLASSIFICATION_NO_TEXT_BEYOND_TITLE,
+    CLASSIFICATION_SUMMARY_EMPTY_OTHER_TEXT_PRESENT,
+    CLASSIFICATION_SUMMARY_PRESENT,
+    CLASSIFICATIONS,
+    DERIVED_INPUTS_FILENAME,
+    PROVIDER_RESPONSE_AUDIT_FILENAME,
+    STOCKSTATS_DEFAULT_INDICATOR_DEFINITIONS,
+    build_derived_inputs_artifact,
+    build_provider_response_artifact,
+    format_indicator_value,
+    recompute_derived_inputs,
+    recompute_ohlcv_indicators,
+    sanitize_provider_value,
+    series_sha256,
+)
+from comqutor_alpha.source_provenance import build_source_registry, public_source_fields
+from tradingagents.dataflows.source_capture import CapturedSources, record_aux, record_source, source_capture_scope
+
+TICKER = "SYN"  # a synthetic instrument -- never a real-market validation sample
+ANALYSIS_DATE = "2026-08-10"
+
+# the same standard as the Round-19 credential scan
+SECRET_PATTERNS = (
+    re.compile(r"sk-[A-Za-z0-9_-]{20,}"), re.compile(r"AIza[0-9A-Za-z_-]{30,}"), re.compile(r"AKIA[0-9A-Z]{16}"),
+    re.compile(r"gh[pousr]_[A-Za-z0-9]{30,}"), re.compile(r"Bearer\s+[A-Za-z0-9._~+/=-]{24,}"),
+    re.compile(r"(?i)(api[_-]?key|secret|token|password)\s*[=:]\s*['\"]?(?!<redacted|REDACTED|\*|None|null|\s)[A-Za-z0-9_\-/+=]{16,}"),
+    re.compile(r"postgres(?:ql)?(?:\+\w+)?://[^:\s/]+:(?!<redacted>|REDACTED|\*)[^@\s<]{3,}@"),
+)
+
+
+def _synthetic_ohlcv(rows: int = 320, seed: int = 11) -> pd.DataFrame:
+    """320 business days: enough for the 200-day SMA. Random walk, fixed seed -- SYNTHETIC."""
+    rng = np.random.default_rng(seed)
+    dates = pd.bdate_range(end=ANALYSIS_DATE, periods=rows)
+    close = 100 + np.cumsum(rng.normal(0, 1.0, rows))
+    return pd.DataFrame({
+        "Date": dates,
+        "Open": close + rng.normal(0, 0.3, rows),
+        "High": close + np.abs(rng.normal(1.0, 0.3, rows)),
+        "Low": close - np.abs(rng.normal(1.0, 0.3, rows)),
+        "Close": close,
+        "Volume": rng.integers(1_000_000, 5_000_000, rows),
+    })
+
