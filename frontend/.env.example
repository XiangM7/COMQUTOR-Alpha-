# COMQUTOR Alpha API base URL. Empty (unset/blank) means same-origin --
# requests go to whatever host is currently serving this frontend. Set this
# only when the API is served from a different origin during local
# development (e.g. the API running on 127.0.0.1:8000 while the frontend
# dev server runs on 127.0.0.1:5173).
#
# Never put an API key, a database URL, or any provider credential in this
# file or in any other VITE_* variable -- everything in import.meta.env is
# bundled into the client-side JavaScript and is publicly visible in the
# browser.
VITE_COMQUTOR_API_BASE_URL=http://127.0.0.1:8000
